# =============================================================================
# ETP - Enterprise Trading Platform: environment configuration
#
# This is the working .env (git-ignored: it holds real secrets). Its keys mirror .env.example.
# Copy of .env.example with the real values filled in. This file lists EVERY variable the platform reads, so
# .env and .env.example must always contain the same keys (npm run validate:config checks it).
# Service endpoints follow the deployment PDF: frontend 4200, auth 3000, order 8081,
# executor 8082, PostgreSQL 5432 (trading_system_db), Kafka kafka:29092 on the Docker network.
# =============================================================================

# --- Frontend (Angular) ------------------------------------------------------
FRONTEND_URL=http://localhost
FRONTEND_PORT=4200

# --- Auth service (NestJS) ---------------------------------------------------
AUTH_SERVICE_URL=http://localhost
AUTH_SERVICE_PORT=3000

# --- Order service (Spring Boot, services/trade-api) -------------------------
ORDER_SERVICE_URL=http://localhost
ORDER_SERVICE_PORT=8081

# --- Executor service (Spring Boot, services/executor) -----------------------
EXECUTOR_SERVICE_URL=http://localhost
EXECUTOR_SERVICE_PORT=8082
# How often the executor polls market data, in seconds
POLL_INTERVAL_SECONDS=60

# --- PostgreSQL: one database, two schemas (trade = orders side, auth = logins) -
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_system_db
DB_USER=postgres
DB_PASSWORD=n3u3d4!
DB_SCHEMA_TRADE=trade
DB_SCHEMA_AUTH=auth

# --- JWT (the same secret and issuer must be set for auth, order and executor) -
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=c2VjdXJpdHktc2VjcmV0LWZvci1ldHAtY2Fwc3RvbmUtdGVhbTItMjAyNg==
JWT_ISSUER=auth-service
JWT_ALGORITHM=HS256
# Access token lifetime in seconds
